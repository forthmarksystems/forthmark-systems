---
import "../styles/demo.css";

interface Props {
  title: string;
  description: string;
  demo: "operations" | "programme";
  caseStudy: string;
}

const { title, description, demo, caseStudy } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Forthmark Systems Demo</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#121714" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body data-demo={demo}>
    <div class="demo-ribbon">
      <strong>Concept demonstration.</strong>
      <span>Not a client deployment. Every name and record is sample data.</span>
      <a href={caseStudy}>Read the case study</a>
      <a href="/work">All work</a>
    </div>
    <slot />
  </body>
</html>
