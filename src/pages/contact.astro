---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
---

<BaseLayout
  title="Contact"
  description="Tell Forthmark Systems about the process, website or system you need. Share the problem, the people involved and the outcome you want."
>
  <header class="page-head">
    <div class="container page-head__grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="h1">Start with<br />the problem.</h1>
      </div>
      <p class="lede">
        You do not need a finished brief. Describe what is happening now, who it
        affects, and what a better outcome would look like. We will reply with a
        useful next step, even if that step is not us.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container contact-grid">
      <aside class="contact-aside">
        <div class="contact-block">
          <h3>Email</h3>
          <p>
            <a href="mailto:hello@forthmarksystems.com">hello@forthmarksystems.com</a>
          </p>
          <p class="small mt-1">
            Placeholder address. Replace it with the official Forthmark inbox
            before launch.
          </p>
        </div>

        <div class="contact-block">
          <h3>Where we work</h3>
          <p>
            Businesses in Nigeria, and remote engagements elsewhere. Work is
            delivered online with scheduled calls and written updates.
          </p>
        </div>

        <div class="contact-block">
          <h3>What happens next</h3>
          <p>
            1. We read the enquiry and check whether the problem fits what we do.
          </p>
          <p>
            2. If it does, we ask a few clarifying questions and arrange a short
            conversation.
          </p>
          <p>
            3. You receive a written recommendation: what to build, what to leave
            alone, and a realistic sequence.
          </p>
        </div>

        <div class="contact-block">
          <h3>Useful to include</h3>
          <p>
            The process that is causing friction, the tools you use today, who
            will use the system, and any deadline that is already fixed.
          </p>
        </div>
      </aside>

      <form
        class="form"
        name="project-enquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
      >
        <input type="hidden" name="form-name" value="project-enquiry" />
        <p class="visually-hidden">
          <label>Do not fill this out if you are human <input name="bot-field" /></label>
        </p>

        <div class="form__row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="business">Business or organisation</label>
            <input
              id="business"
              name="business"
              type="text"
              autocomplete="organization"
            />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>
          <div class="field">
            <label for="phone">Phone or WhatsApp</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
            <span class="hint">Optional. Include the country code if outside Nigeria.</span>
          </div>
        </div>

        <div class="field">
          <label for="service">Service required</label>
          <select id="service" name="service" required>
            <option value="">Choose the closest fit</option>
            <option>Website and digital presence</option>
            <option>Business systems and process automation</option>
            <option>Custom digital solution</option>
            <option>Not sure yet, I need advice</option>
          </select>
        </div>

        <div class="field">
          <label for="problem">The problem to solve</label>
          <textarea
            id="problem"
            name="problem"
            required
            aria-describedby="problem-hint"
            placeholder="What happens today, who is affected, and what would improve?"
          ></textarea>
          <span class="hint" id="problem-hint">
            A few sentences is enough. Avoid sending passwords, payment details or
            sensitive customer records through this form.
          </span>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="budget">Budget range</label>
            <select id="budget" name="budget">
              <option value="">Prefer to discuss</option>
              <option>Under 500,000 NGN</option>
              <option>500,000 to 1,500,000 NGN</option>
              <option>1,500,000 to 4,000,000 NGN</option>
              <option>Above 4,000,000 NGN</option>
            </select>
            <span class="hint">Optional. It helps us suggest a sensible scope.</span>
          </div>
          <div class="field">
            <label for="timeline">Timeline</label>
            <select id="timeline" name="timeline">
              <option value="">Not sure yet</option>
              <option>As soon as possible</option>
              <option>Within 1 to 3 months</option>
              <option>Within 3 to 6 months</option>
              <option>Later this year or beyond</option>
            </select>
            <span class="hint">Optional. Fixed deadlines are worth mentioning above.</span>
          </div>
        </div>

        <div class="btn-row">
          <button class="btn btn--primary" type="submit">
            Send enquiry <span class="arrow" aria-hidden="true">&rarr;</span>
          </button>
        </div>

        <p class="form__note">
          This form is handled by Netlify Forms on the deployed site. If you prefer
          email, write to
          <a href="mailto:hello@forthmarksystems.com">hello@forthmarksystems.com</a>.
          Details are used only to respond to your enquiry.
        </p>
      </form>
    </div>
  </section>

  <CtaBand
    title="Not ready to send a brief?"
    text="Look through the work first. The Culia Autos case study shows a live deployment, and the concept demos show how an operational system behaves."
    primaryLabel="See our work"
    primaryHref="/work"
    secondaryLabel="How we work"
    secondaryHref="/how-we-work"
  />
</BaseLayout>
