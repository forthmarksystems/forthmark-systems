---
import DemoLayout from "../../layouts/DemoLayout.astro";
---

<DemoLayout
  title="Business Operations System Demo"
  description="A working concept demonstration of an SME operations system: customers, inventory, orders, tasks, reporting and settings. Sample data only."
  demo="operations"
  caseStudy="/work/operations-system"
>
  <div class="demo-app">
    <aside class="d-sidebar">
      <div class="d-brand">
        <span class="d-brand__mark" aria-hidden="true">N</span>
        <span class="d-brand__text" id="brand-name">Northline Supply Co.<small>Demo workspace</small></span>
      </div>
      <nav class="d-nav" id="demo-nav" aria-label="Demo sections"></nav>
      <div class="d-sidebar__foot">
        <span class="d-avatar" aria-hidden="true">DM</span>
        <span>Demo Manager<br />Concept workspace</span>
      </div>
    </aside>

    <div class="d-main">
      <header class="d-topbar">
        <div>
          <h1 id="view-title">Dashboard</h1>
          <p id="view-subtitle">Sales, stock and work in progress.</p>
        </div>
        <div class="d-topbar__actions">
          <button class="d-btn d-btn--ghost" type="button" data-action="reset">
            Reset demo
          </button>
          <a class="d-btn d-btn--ghost" href="/work/operations-system">Case study</a>
        </div>
      </header>
      <div class="d-view" id="view"></div>
    </div>
  </div>

  <dialog class="d-modal" id="modal" aria-labelledby="modal-title"></dialog>
  <div class="d-toast" id="toast" role="status" aria-live="polite"></div>
</DemoLayout>

<script>
  import "../../scripts/ops-demo.js";
</script>
